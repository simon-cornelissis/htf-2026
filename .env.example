# Server-only secrets. Copy to .env (which git ignores) and fill in.
# CUSTODIAN, the in-app chat assistant, needs an Anthropic API key (https://console.anthropic.com).
# Without it the chat panel shows "offline" and the rest of the app keeps working.
ANTHROPIC_API_KEY=

# Critical alerts (all channels are optional).
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
